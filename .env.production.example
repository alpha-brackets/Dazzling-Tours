# =============================================================================
# PRODUCTION TEMPLATE
# -----------------------------------------------------------------------------
# Either copy to .env.production on the server:
#
#   cp .env.production.example .env.production
#
# or set these in your host's environment settings (Vercel project env vars,
# Docker secrets, systemd unit). .env.production is gitignored — never commit a
# filled-in copy.
#
# -----------------------------------------------------------------------------
# How Next.js loads these files (official load order)
# -----------------------------------------------------------------------------
# Next.js looks a variable up in this order and stops at the first hit:
#
#   1. process.env                     (real host environment — highest)
#   2. .env.production.local
#   3. .env.local
#   4. .env.production                 <-- this file's target
#   5. .env
#
# ==> Do NOT put a .env.local on the production server. It sits ABOVE
#     .env.production in that order, so it would silently override production
#     values with development ones. Deploy .env.production only.
#
# .env.production is loaded when NODE_ENV=production, i.e. `next build` and
# `next start` — not `next dev`.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at BUILD time.
# Changing one requires a REBUILD and redeploy, not just a restart. Never give
# a secret a NEXT_PUBLIC_ prefix — it becomes readable by anyone.
#
# Required variables are enforced at startup by src/lib/env.ts via
# src/instrumentation.ts: a missing one aborts the boot and is named in the
# error, so a misconfigured deployment fails loudly instead of serving a
# broken or insecure site.
#
# Every secret below must be UNIQUE PER DEPLOYMENT. Do not reuse one client's
# credentials for another, and rotate anything that has ever been committed,
# pasted into a ticket, or shipped in a client bundle.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED — server will not start without it)
# -----------------------------------------------------------------------------
# Restrict the database user to this database only, and lock the Atlas IP
# access list down to your host.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dazzling-tours?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# URLs (REQUIRED — server will not start without these)
# -----------------------------------------------------------------------------
# Use HTTPS and the exact canonical form you serve (apex vs www). These strings
# are baked into sitemap.xml, robots.txt, metadataBase, and every email link.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_BASE_URL=https://example.com
# Leave EMPTY unless the API is served from a different origin than the site.
NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Authentication — NO CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Admin sessions are database-backed opaque tokens stored in an httpOnly
# cookie, not signed JWTs. Consequences worth knowing when you deploy:
#
#   - There is no signing secret to set, so no deployment can be compromised
#     by a shared or forgotten one, and no two deployments can ever accept
#     each other's sessions.
#   - Only a SHA-256 hash of each token is stored, so a database dump cannot
#     be replayed as a live session.
#   - Logout deletes the session row: access is revoked immediately, not after
#     the token expires.
#   - Expiry is enforced by a MongoDB TTL index. No cron or timer needed.
#
# Session lifetime is SESSION_TTL_DAYS in src/lib/auth.ts (default 7 days).
# JWT_SECRET / JWT_EXPIRES_IN are obsolete and read by nothing.

# -----------------------------------------------------------------------------
# Email — Mailtrap live sending API (REQUIRED for OTP and password reset)
# -----------------------------------------------------------------------------
# Production sends real email, so use the SENDING API, not the sandbox.
# Token: mailtrap.io > Sending Domains > API Tokens.
MAILTRAP_TOKEN=
MAILTRAP_HOST=send.smtp.mailtrap.io
MAILTRAP_PORT=587
# MAILTRAP_USER defaults to "api" and MAILTRAP_PASS falls back to
# MAILTRAP_TOKEN, so both may be left unset when using the sending API.
# MAILTRAP_USER=api
# MAILTRAP_PASS=
# Must be an address on a Mailtrap-VERIFIED sending domain, or mail is rejected.
MAILTRAP_FROM_EMAIL=hello@example.com
SMTP_FROM_NAME=Dazzling Tours
# Legacy fallback for the sender address, used only if MAILTRAP_FROM_EMAIL is
# unset (see src/lib/services/emailService.ts). Prefer MAILTRAP_FROM_EMAIL.
# SMTP_USER=

# -----------------------------------------------------------------------------
# Image uploads — ImageKit (REQUIRED for media management)
# -----------------------------------------------------------------------------
# Provider: IMAGEKIT | CLOUDINARY (only IMAGEKIT is implemented).
NEXT_PUBLIC_IMAGE_PROVIDER=IMAGEKIT
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
# Server-only signing key. Must never appear with a NEXT_PUBLIC_ prefix.
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# -----------------------------------------------------------------------------
# Admin seeding — one-time and manual
# -----------------------------------------------------------------------------
# Seeding is CREATE-ONLY and never runs automatically. Run it ONCE by hand when
# standing up a new deployment. The script takes the domain and the secret from
# this file, so there is nothing to type:
#   npm run seed:admin:prod
#
# Set ADMIN_PASSWORD below for that first run, sign in, change the password from
# the admin panel, then clear the variable again. That way the password never
# depends on the credentials email arriving.
#
# If the admin already exists the endpoint is a no-op and will NOT reset the
# password. To recover a lost admin password use the forgot-password flow.
ADMIN_EMAIL=admin@example.com
# Leave EMPTY in production: the initial password is then generated randomly
# and emailed, instead of sitting in plaintext in a file or an env panel.
ADMIN_PASSWORD=
# Server-only secret guarding the seed endpoint. Generate a UNIQUE value per
# deployment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER expose this as NEXT_PUBLIC_* — that ships it in the browser bundle and
# lets anyone on the internet call the seed endpoint.
SEED_SECRET=
