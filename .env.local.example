# =============================================================================
# LOCAL DEVELOPMENT TEMPLATE
# -----------------------------------------------------------------------------
# Copy to .env.local, then fill in the TODO values:
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored. Never commit real credentials.
#
# -----------------------------------------------------------------------------
# How Next.js loads these files (official load order)
# -----------------------------------------------------------------------------
# Next.js looks a variable up in this order and stops at the first hit:
#
#   1. process.env                     (real shell/host environment)
#   2. .env.$(NODE_ENV).local          e.g. .env.development.local
#   3. .env.local                      <-- this file's target
#   4. .env.$(NODE_ENV)                e.g. .env.development
#   5. .env
#
# Two consequences worth knowing:
#   - .env.local wins over .env.development and .env, in BOTH dev and
#     production. Keep it on your machine only; a stray .env.local on the
#     server would override .env.production there.
#   - .env.local is NOT loaded when NODE_ENV=test, so tests get a clean slate.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at BUILD time.
# Changing one requires restarting `next dev` (or a rebuild), not just a reload.
# Never give a secret a NEXT_PUBLIC_ prefix — it becomes public.
#
# Required variables are enforced at startup by src/lib/env.ts via
# src/instrumentation.ts: if one is missing the server refuses to boot and
# names it, rather than failing later in a confusing way.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED — server will not start without it)
# -----------------------------------------------------------------------------
# Use a local database so development can never touch production data.
MONGODB_URI=mongodb://localhost:27017/dazzling-tours
# No local MongoDB? Run one in Docker:
#   docker run -d -p 27017:27017 --name dazzling-mongo mongo:7
# Or create a SEPARATE Atlas database for development. Do not point this at
# the production cluster.

# -----------------------------------------------------------------------------
# URLs (REQUIRED — server will not start without these)
# -----------------------------------------------------------------------------
# Canonical site URL. Used by src/app/sitemap.ts, src/app/robots.ts, and
# metadataBase in src/app/layout.tsx.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used to build absolute links inside outgoing email.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Base URL for the browser's API client (src/lib/privateAxios.ts).
# Leave EMPTY for same-origin requests — correct for local development.
NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Authentication — NO CONFIGURATION REQUIRED
# -----------------------------------------------------------------------------
# Admin sessions are database-backed opaque tokens stored in an httpOnly
# cookie, not signed JWTs. There is no signing secret to generate, share
# between environments, or accidentally leave unset.
#
# Session lifetime is SESSION_TTL_DAYS in src/lib/auth.ts (default 7 days),
# enforced by a MongoDB TTL index. Logging out deletes the session row, so
# access is revoked immediately.
#
# JWT_SECRET / JWT_EXPIRES_IN are obsolete and read by nothing.

# -----------------------------------------------------------------------------
# Email — Mailtrap sandbox (optional; email features fail without it)
# -----------------------------------------------------------------------------
# In development use the Mailtrap SANDBOX inbox: messages are captured and
# never delivered to real recipients.
# TODO: fill from mailtrap.io > Inboxes > your inbox > SMTP Settings.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
# Leave MAILTRAP_TOKEN unset locally — it authenticates the LIVE sending API
# and would send real email from your development machine.
# MAILTRAP_TOKEN=
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
SMTP_FROM_NAME=Dazzling Tours (dev)
# Legacy fallback for the sender address, used only if MAILTRAP_FROM_EMAIL is
# unset (see src/lib/services/emailService.ts). Prefer MAILTRAP_FROM_EMAIL.
# SMTP_USER=

# -----------------------------------------------------------------------------
# Image uploads — ImageKit (optional; uploads fail without it)
# -----------------------------------------------------------------------------
# Provider: IMAGEKIT | CLOUDINARY (only IMAGEKIT is implemented).
NEXT_PUBLIC_IMAGE_PROVIDER=IMAGEKIT
# TODO: fill from imagekit.io > Developer Options > API Keys.
# Prefer a separate development ImageKit instance so test uploads do not land
# in the production media library.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# -----------------------------------------------------------------------------
# Admin seeding — one-time and manual (optional)
# -----------------------------------------------------------------------------
# Seeding is CREATE-ONLY and never runs automatically. If the admin already
# exists the endpoint is a no-op and will NOT reset the password.
#
# After pointing at an empty database, create the admin once (with the dev
# server running). The script takes the domain and the secret from this file:
#   npm run seed:admin
# Must be a real-looking address: the User schema's email pattern rejects TLDs
# longer than 3 characters, so ".local" and ".localhost" fail validation.
ADMIN_EMAIL=admin@dazzlingtours.dev
# Set a known password locally so you can sign in without working email.
# If empty, a random password is generated and emailed instead.
ADMIN_PASSWORD=
# Server-only secret guarding the seed endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER expose this as NEXT_PUBLIC_* — that ships it in the browser bundle and
# lets anyone call the seed endpoint.
SEED_SECRET=
