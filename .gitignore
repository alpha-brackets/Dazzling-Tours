# Dependencies
node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store

# Secrets / credentials
*.pem
*.key
*.p12
*.pfx
service-account*.json

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files — ignore every real one, including .env, .env.local,
# .env.development, .env.production and any variant.
.env
.env.*

# ...but keep the committed placeholder templates. These are the only env
# files that belong in git, and they must never contain real values:
#   env.development.example, env.production.example
!env.*.example
!.env.example
!.env.*.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/settings.local.json

# AI assistant artifacts — editor-generated chat transcripts, not app code.
# These can contain pasted secrets and internal discussion, so they must never
# ship in a repo handed to a client.
.specstory/
.cursorindexingignore

# OS
Thumbs.db
